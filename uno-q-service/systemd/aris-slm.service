[Unit]
Description=ARIS Local Small Language Model (Qwen 2.5 0.5B on Port 8089)
After=network.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/ArduinoApps/aeris
Nice=-5
CPUAffinity=0 1 2 3
ExecStart=/usr/local/bin/llama-server -m /home/arduino/ArduinoApps/aeris/models/qwen2.5-0.5b-instruct-q4_k_m.gguf --port 8089 --host 127.0.0.1 -c 512 -b 256 -t 4 -tb 4 --temp 0.35
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
