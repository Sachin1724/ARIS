[Unit]
Description=ARIS Local Edge SLM (Qwen 2.5 0.5B via llama.cpp, port 8089)
After=network.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/aeris_slm
# Paths must match what is actually installed on the board: the binary is built
# in the user's llama.cpp tree, and the model lives beside it.
ExecStart=/home/arduino/llama.cpp/build/bin/llama-server \
  -m /home/arduino/aeris_slm/models/qwen2.5-0.5b-q4.gguf \
  --host 127.0.0.1 --port 8089 -c 1024 -ngl 0 -t 3
# The 1Hz telemetry API matters more than token throughput, so inference runs
# at lower priority and leaves one of the four cores for it.
Nice=3
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
