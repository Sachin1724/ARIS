[Unit]
Description=ARIS Edge FastAPI Server (Port 8000)
After=network.target aris-slm.service

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/ArduinoApps/aeris
ExecStart=/usr/bin/python3 -m uvicorn aeris_hotspot:app --app-dir python --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
